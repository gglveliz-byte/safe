# ==============================================================================
# SAFE — Variables de entorno de Backend
# Copiar este archivo como `.env` y completar con credenciales reales.
# NINGÚN valor de este archivo es un secreto de producción.
# ==============================================================================

# PostgreSQL 16+ (Neon, Supabase, RDS). Usar sslmode=require en producción.
DATABASE_URL="postgresql://usuario:password@localhost:5432/safe?schema=public&sslmode=prefer"

# Secreto de firma JWT HS256. Mínimo 32 caracteres aleatorios.
JWT_SECRET="reemplace-con-un-secreto-de-al-menos-32-caracteres"

# Clave maestra del panel administrativo. Mínimo 24 caracteres.
ADMIN_MASTER_KEY="reemplace-con-una-clave-maestra-larga-y-unica"
ADMIN_EMAIL="admin@safe.example"
ADMIN_PASSWORD="reemplace-con-una-contrasena-segura-de-12-caracteres"

# URL pública canónica de la plataforma (sin barra final).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary — carga de fotografías faciales optimizadas.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="safe/riders"

# Gmail SMTP — despacho de alertas de emergencia.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM_NAME="SAFE Emergency Dispatch"

# Límites operativos (opcionales; se validan con valores por defecto seguros).
EMERGENCY_COOLDOWN_SECONDS="180"
EMERGENCY_DISTANCE_THRESHOLD_METERS="150"
PIN_MAX_ATTEMPTS="5"
PIN_BLOCK_MINUTES="15"
SESSION_TTL_SECONDS="2592000"
TERMS_VERSION="2026-01"
